PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/firecrawl
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_NAME=scrape-url
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=super_secret_jwt_key_firecrawl_dev_change_me
JWT_EXPIRES_IN=7d

# Socket.io & Realtime Configuration
MAX_SOCKETS_PER_USER=10

# Google OAuth (placeholders)
GOOGLE_CLIENT_ID=your_google_client_id_placeholder
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# GitHub OAuth (placeholders)
GITHUB_CLIENT_ID=your_github_client_id_placeholder
GITHUB_CLIENT_SECRET=your_github_client_secret_placeholder

# Phase 6: AI Fallback & Self-Healing
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-1.5-flash
MAX_AI_HTML_CHARS=20000
AI_CACHE_TTL_SECONDS=86400
AI_CONCURRENCY=2
AI_MAX_CALLS_PER_RUN=200
AI_DAILY_CALLS_PER_USER=500
