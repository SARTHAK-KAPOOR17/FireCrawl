REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
MONGODB_URI=mongodb://localhost:27017/firecrawl
QUEUE_NAME=scrape-url
WORKER_CONCURRENCY=5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 FireCrawl/1.0

# Phase 3: Efficiency Layer
HTML_CACHE_TTL_SECONDS=3600
DOMAIN_RATE_LIMIT_RPS=5
BATCH_SIZE=25
FLUSH_INTERVAL_MS=200

# Phase 6: AI Fallback & Self-Healing
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-1.5-flash
MAX_AI_HTML_CHARS=20000
AI_CACHE_TTL_SECONDS=86400
AI_CONCURRENCY=2
AI_MAX_CALLS_PER_RUN=200
AI_DAILY_CALLS_PER_USER=500
