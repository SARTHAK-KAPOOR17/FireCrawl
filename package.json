{
  "name": "firecrawl",
  "version": "1.0.0",
  "private": true,
  "description": "Web scraping and data extraction engine",
  "workspaces": [
    "server",
    "worker",
    "client"
  ],
  "scripts": {
    "server": "npm run dev --prefix server",
    "worker": "npm run dev --prefix worker",
    "client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:worker": "npm run dev --prefix worker",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:worker\" \"npm run dev:client\"",
    "test": "npm test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
